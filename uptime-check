#!/usr/bin/env bash

# Manual HTTP uptime checks.
# URLs are read from the user configuration directory by default (one URL per line).

set -u

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/uptime-check/urls"
USING_DEFAULT_CONFIG=true
TIMEOUT_SECONDS=10
INTERFACE=""
DIRECT=false

usage() {
    cat <<'EOF'
Usage: uptime-check [options]

Checks the HTTP status and response time for every URL in a list.

Options:
  -f, --file FILE        URL list file (default: ~/.config/uptime-check/urls)
  -t, --timeout SECONDS  Per-URL timeout in seconds (default: 10)
  -i, --interface NAME   Bind requests to this network interface
      --direct           Use the physical interface from the main Internet route (bypasses NetBird exit-node routing)
  -h, --help             Show this help

List format: one URL per line. Empty lines and lines beginning with # are ignored.
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 2
}

ensure_config() {
    if [[ -e "$CONFIG_FILE" ]]; then
        [[ -r "$CONFIG_FILE" ]] || fail "Cannot read URL list: $CONFIG_FILE"
        return
    fi

    if ! "$USING_DEFAULT_CONFIG"; then
        fail "URL list does not exist: $CONFIG_FILE. Create it with one URL per line."
    fi

    mkdir -p "$(dirname -- "$CONFIG_FILE")" || fail "Cannot create configuration directory for: $CONFIG_FILE"
    {
        printf '# uptime-check URLs\n'
        printf '# One URL per line. Empty lines and comments are ignored.\n'
        printf '# Example: https://example.com/health\n'
    } > "$CONFIG_FILE" || fail "Cannot create URL list: $CONFIG_FILE"

    fail "Configuration created: $CONFIG_FILE. Add one URL per line, then run uptime-check again."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--file)
            [[ $# -ge 2 ]] || fail "Missing value for $1"
            CONFIG_FILE="$2"
            USING_DEFAULT_CONFIG=false
            shift 2
            ;;
        -t|--timeout)
            [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || fail "Timeout must be a positive integer"
            TIMEOUT_SECONDS="$2"
            shift 2
            ;;
        -i|--interface)
            [[ $# -ge 2 ]] || fail "Missing value for $1"
            INTERFACE="$2"
            shift 2
            ;;
        --direct)
            DIRECT=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "Unknown option: $1"
            ;;
    esac
done

ensure_config
command -v curl >/dev/null || fail "curl is required"

if "$DIRECT"; then
    [[ -z "$INTERFACE" ]] || fail "Use either --direct or --interface, not both"
    command -v ip >/dev/null || fail "ip is required for --direct"

    # NetBird exit nodes add a higher-priority policy route to wt0.  The main
    # routing table keeps the physical LAN/Wi-Fi default route, which is what
    # we deliberately use for an external uptime check.
    INTERFACE="$(ip -4 route show table main default 2>/dev/null | sed -n '1{s/.* dev \([^ ]*\).*/\1/p;}')"
    [[ -n "$INTERFACE" ]] || fail "Unable to identify the physical Internet interface. Use --interface NAME instead."

    if [[ "$INTERFACE" =~ (netbird|wt[0-9]*) ]]; then
        fail "The normal route uses NetBird interface '$INTERFACE'. Choose your physical interface with --interface NAME, or adjust NetBird routing."
    fi
fi

curl_options=(
    --silent
    --show-error
    --location
    --output /dev/null
    --connect-timeout "$TIMEOUT_SECONDS"
    --max-time "$TIMEOUT_SECONDS"
    --write-out '%{http_code}|%{time_total}|%{url_effective}'
)

if [[ -n "$INTERFACE" ]]; then
    curl_options+=(--interface "$INTERFACE")
    printf 'Bound to interface: %s\n' "$INTERFACE"
fi

total=0
failed=0

while IFS= read -r line || [[ -n "$line" ]]; do
    url="${line%%#*}"
    # Trim surrounding whitespace without modifying whitespace inside URLs.
    url="${url#"${url%%[![:space:]]*}"}"
    url="${url%"${url##*[![:space:]]}"}"
    [[ -n "$url" ]] || continue

    total=$((total + 1))
    result="$(curl "${curl_options[@]}" "$url" 2>&1)"
    exit_code=$?

    metadata="${result##*$'\n'}"
    curl_error="${result%$'\n'*}"
    [[ "$curl_error" == "$metadata" ]] && curl_error=""

    if [[ "$metadata" =~ ^([0-9]{3})\|([0-9.]+)\|(.*)$ ]]; then
        http_code="${BASH_REMATCH[1]}"
        duration="${BASH_REMATCH[2]}"
        final_url="${BASH_REMATCH[3]}"
    else
        http_code="000"
        duration="-"
        final_url="$url"
    fi

    if [[ $exit_code -eq 0 && "$http_code" =~ ^[23][0-9]{2}$ ]]; then
        printf 'OK    %s  %ss  %s\n' "$http_code" "$duration" "$final_url"
    else
        failed=$((failed + 1))
        if [[ $exit_code -ne 0 ]]; then
            printf 'FAIL  %s  %ss  %s%s\n' "$http_code" "$duration" "$final_url" "${curl_error:+ ($curl_error)}" >&2
        else
            printf 'FAIL  %s  %ss  %s\n' "$http_code" "$duration" "$final_url" >&2
        fi
    fi
done < "$CONFIG_FILE"

[[ $total -gt 0 ]] || fail "No URL found in $CONFIG_FILE"

printf '\n%d checked, %d failed.\n' "$total" "$failed"
[[ $failed -eq 0 ]]
